{
  "name": "@arcforge/cognet",
  "version": "2.0.244",
  "license": "Apache-2.0",
  "description": "The cognet authoring surface for Axon — an agent's brain, compiled, versioned and swappable.",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ecs": "./src/ecs/index.ts",
    "./schedule": "./src/schedule/index.ts",
    "./schema": "./src/schema/index.ts",
    "./python/declare.py": "./python/cognet/declare.py",
    "./python/serve.py": "./python/serve.py",
    "./proto/cognet.proto": "./proto/cognet/cognet.proto",
    "./rust/Cargo.toml": "./rust/Cargo.toml",
    "./interfaces/*": "./interfaces/*.interface.ts"
  },
  "files": [
    "src",
    "python",
    "proto",
    "interfaces",
    "rust/Cargo.toml",
    "rust/cognet/Cargo.toml",
    "rust/cognet/src",
    "rust/cognet-macros/Cargo.toml",
    "rust/cognet-macros/src"
  ],
  "scripts": {
    "test": "bun run test:full",
    "test:hot": "bun test --parallel=4 tests/hot",
    "test:full": "bun test --parallel=4 tests/hot && cargo test --manifest-path rust/Cargo.toml --target-dir ../../../.output/cargo/cognet",
    "deploy": "echo \"This package is published ONLY by apps/tui/scripts/release.ts, which pins workspace:* deps to concrete versions first. Publishing it directly ships an unresolvable dependency.\" && exit 1"
  },
  "dependencies": {
    "@arcforge/err": "workspace:*",
    "@arcforge/types": "workspace:*",
    "hookable": "^5.5.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "homepage": "https://axon.arclabs.it/docs/v2/cognets/api/loop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artificial-cognition-laboratories/axon.git",
    "directory": "libs/axon/cognet"
  },
  "bugs": {
    "url": "https://github.com/artificial-cognition-laboratories/axon/issues"
  },
  "keywords": [
    "axon",
    "ai",
    "agent",
    "agents",
    "llm",
    "ai-agent",
    "agent-runtime",
    "typescript"
  ],
  "axonRevision": "6b7c31b386531c7829eb28a9f00480022cdc01f8"
}
