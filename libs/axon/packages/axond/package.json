{
    "name": "@arcforge/axond",
    "version": "2.0.242",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./types": {
            "types": "./types/index.ts",
            "default": "./types/index.ts"
        },
        "./bin/axond.ts": "./bin/axond.ts"
    },
    "bin": {
        "axond": "./bin/axond.ts"
    },
    "files": [
        "src/**/*.ts",
        "src/**/*.py",
        "types/**/*.ts",
        "bin/**/*.ts"
    ],
    "scripts": {
        "test": "bun run test:full",
        "test:hot": "bun test --parallel=4 tests/hot",
        "test:full": "bun test --parallel=4 tests/hot tests/full tests/integration",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@arcforge/arcline": "workspace:*",
        "@arcforge/body": "workspace:*",
        "@arcforge/cloud": "workspace:*",
        "@arcforge/err": "workspace:*",
        "@arcforge/link": "workspace:*",
        "@arcforge/platform": "workspace:*",
        "@arcforge/types": "workspace:*",
        "@huggingface/transformers": "^4.2.0",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@arclabs/repo": "workspace:*",
        "@types/bun": "latest",
        "node-llama-cpp": "3.20.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "axonRevision": "99908cacd44ba4553e69d591f3b66811d4cf7d42"
}
