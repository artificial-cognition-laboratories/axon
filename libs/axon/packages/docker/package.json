{
    "name": "@axon/docker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "@arcforge/platform": "workspace:*",
        "@arcforge/core": "workspace:*",
        "crossws": "^0.3.5",
        "h3": "^1.13.0"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "scripts": {
        "test": "bun run test:full",
        "test:hot": "bun test tests/hot",
        "test:full": "bun run test:hot && bun test tests/full",
        "deploy": "bun run deploy.ts",
        "deploy:bump:patch": "bun run deploy.ts --bump patch",
        "deploy:bump:minor": "bun run deploy.ts --bump minor",
        "deploy:local": "bun run deploy.ts --local"
    }
}
