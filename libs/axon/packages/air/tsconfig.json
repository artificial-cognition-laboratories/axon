{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "lib": [
            "ESNext"
        ],
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": [
            "bun"
        ]
    },
    "include": [
        "src",
        "tests/**/*.ts"
    ]
}
